# Build prerequisites only. Model acquisition belongs to the future installer.
# No Python interpreter, bindings or scripts are executed.
cmake_minimum_required(VERSION 3.20)
get_filename_component(NATIVE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(READ "${NATIVE_ROOT}/assets.lock.json" lock)
if(NOT NATIVE_PLATFORM)
  if(CMAKE_HOST_WIN32)
    set(NATIVE_PLATFORM windows-x86_64)
  elseif(CMAKE_HOST_APPLE)
    set(NATIVE_PLATFORM macos-arm64)
  else()
    set(NATIVE_PLATFORM linux-x86_64)
  endif()
endif()
function(download_checked url path digest)
  if(EXISTS "${path}")
    file(SHA256 "${path}" actual)
    if(actual STREQUAL digest)
      return()
    endif()
  endif()
  file(DOWNLOAD "${url}" "${path}.partial" TLS_VERIFY ON
    EXPECTED_HASH "SHA256=${digest}" STATUS status TIMEOUT 180)
  list(GET status 0 code)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Download failed: ${status}")
  endif()
  file(RENAME "${path}.partial" "${path}")
endfunction()
file(MAKE_DIRECTORY "${NATIVE_ROOT}/vendor/downloads")
string(JSON repository GET "${lock}" sdk repository)
string(JSON release GET "${lock}" sdk release)
string(JSON archive GET "${lock}" sdk platforms "${NATIVE_PLATFORM}" archive)
string(JSON digest GET "${lock}" sdk platforms "${NATIVE_PLATFORM}" sha256)
set(sdk_archive "${NATIVE_ROOT}/vendor/downloads/${archive}")
download_checked("${repository}/releases/download/${release}/${archive}" "${sdk_archive}" "${digest}")
set(staging "${NATIVE_ROOT}/vendor/downloads/sdk-${NATIVE_PLATFORM}")
file(MAKE_DIRECTORY "${staging}")
file(ARCHIVE_EXTRACT INPUT "${sdk_archive}" DESTINATION "${staging}")
file(STRINGS "${staging}/SHA256SUMS" checksums)
foreach(line IN LISTS checksums)
  if(NOT line MATCHES "^([0-9a-f]+)[ *]+([^/\\]+)$")
    message(FATAL_ERROR "Invalid SDK checksum line")
  endif()
  set(expected "${CMAKE_MATCH_1}")
  set(name "${CMAKE_MATCH_2}")
  file(SHA256 "${staging}/${name}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "SDK checksum mismatch: ${name}")
  endif()
endforeach()
string(JSON source_sha GET "${lock}" sdk source_sha)
file(READ "${staging}/SOURCE.txt" source)
string(FIND "${source}" "${source_sha}" source_position)
if(source_position LESS 0)
  message(FATAL_ERROR "SDK source revision mismatch")
endif()
file(COPY "${staging}/" DESTINATION "${NATIVE_ROOT}/vendor/sdk")
string(JSON file_count LENGTH "${lock}" files)
math(EXPR last_file "${file_count} - 1")
foreach(index RANGE 0 ${last_file})
  string(JSON name MEMBER "${lock}" files ${index})
  string(JSON expected GET "${lock}" files "${name}")
  file(SHA256 "${NATIVE_ROOT}/${name}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Header/data checksum mismatch: ${name}")
  endif()
endforeach()
if(NATIVE_PLATFORM STREQUAL "windows-x86_64")
  string(JSON url GET "${lock}" opencv windows url)
  string(JSON digest GET "${lock}" opencv windows sha256)
  set(opencv_archive "${NATIVE_ROOT}/vendor/downloads/opencv-4.14.0-windows.exe")
  download_checked("${url}" "${opencv_archive}" "${digest}")
  if(NOT EXISTS "${NATIVE_ROOT}/vendor/opencv/build/OpenCVConfig.cmake")
    execute_process(COMMAND "${opencv_archive}" -y "-o${NATIVE_ROOT}/vendor"
      COMMAND_ERROR_IS_FATAL ANY)
  endif()
  file(SHA256 "${NATIVE_ROOT}/vendor/opencv/build/x64/vc16/bin/opencv_world4140.dll" opencv_hash)
  file(SHA256 "${NATIVE_ROOT}/vendor/sdk/opencv_world4140.dll" sdk_hash)
  if(NOT opencv_hash STREQUAL sdk_hash)
    message(FATAL_ERROR "OpenCV development package does not match MediaPipe's DLL")
  endif()
endif()
message(STATUS "Verified native SDK/headers: ${NATIVE_PLATFORM}; no Python or model download")
