# Verify checked-in headers and data. No interpreter or prebuilt OpenCV SDK.
cmake_minimum_required(VERSION 3.24)
get_filename_component(NATIVE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(READ "${NATIVE_ROOT}/assets.lock.json" lock)
string(JSON file_count LENGTH "${lock}" files)
math(EXPR last_file "${file_count} - 1")
foreach(index RANGE 0 ${last_file})
  string(JSON name MEMBER "${lock}" files ${index})
  string(JSON expected GET "${lock}" files "${name}")
  file(SHA256 "${NATIVE_ROOT}/${name}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Header/data checksum mismatch: ${name}")
  endif()
endforeach()
message(STATUS "Verified native headers/data. Build the static SDK using prepare_mediapipe_halide.ps1 and build_mediapipe_halide.ps1 on Windows.")
message(STATUS "SDL3/Clang/Halide downloads: scripts/setup_tracking_toolchain.ps1. Models are not downloaded.")
