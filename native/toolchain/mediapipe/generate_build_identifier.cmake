cmake_minimum_required(VERSION 3.24)
foreach(required OUTPUT INPUT_FILE_LIST CONCAT_TOOL)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
set(bytes_file "${OUTPUT}.bytes")
execute_process(COMMAND "${CONCAT_TOOL}" "${INPUT_FILE_LIST}" "${bytes_file}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot concatenate XNNPACK sources: ${result}")
endif()
file(SHA256 "${bytes_file}" digest)
file(REMOVE "${bytes_file}")
set(bytes "")
foreach(index RANGE 0 31)
  math(EXPR offset "${index} * 2")
  string(SUBSTRING "${digest}" ${offset} 2 byte)
  math(EXPR decimal "0x${byte}")
  if(index GREATER 0)
    string(APPEND bytes ", ")
  endif()
  string(APPEND bytes "${decimal}")
endforeach()
file(WRITE "${OUTPUT}" "// Generated from the sorted XNNPACK source contents using SHA256.\n#include <stdbool.h>\n#include <stdint.h>\n#include <stddef.h>\n#include <string.h>\nstatic const uint8_t xnn_build_identifier[] = {${bytes}};\nsize_t xnn_experimental_get_build_identifier_size(void) { return sizeof(xnn_build_identifier); }\nconst void* xnn_experimental_get_build_identifier_data(void) { return xnn_build_identifier; }\nbool xnn_experimental_check_build_identifier(const void* data, size_t size) {\n  return size == sizeof(xnn_build_identifier) && !memcmp(data, xnn_build_identifier, size);\n}\n")
