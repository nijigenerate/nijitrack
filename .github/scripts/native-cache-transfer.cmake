cmake_minimum_required(VERSION 3.24)
# Transfer already-built caches between GitHub branch scopes without rebuilding.
if(NOT DEFINED ROOT)
  get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
endif()
set(seed "$ENV{NATIVE_CACHE_SEED_DIR}")
if(NOT seed OR NOT MODE MATCHES "^(export|import)$")
  message(FATAL_ERROR "Set MODE=export/import and NATIVE_CACHE_SEED_DIR")
endif()
file(MAKE_DIRECTORY "${seed}")
foreach(component tools sdk)
  string(TOUPPER "${component}" upper)
  set(key "$ENV{NATIVE_${upper}_KEY}")
  if(NOT key)
    message(FATAL_ERROR "Missing ${component} cache key")
  endif()
  set(archive "${seed}/${component}.tar.zst")
  if(component STREQUAL "tools")
    set(paths native/vendor/toolchain native/vendor/downloads native/vendor/sources native/build-sdl3)
    set(allowed "^native/(vendor/(toolchain|downloads|sources)|build-sdl3)(/|$)")
  else()
    set(paths native/vendor/sdk-halide)
    set(allowed "^native/vendor/sdk-halide(/|$)")
  endif()
  if(MODE STREQUAL "export")
    set(existing)
    foreach(path IN LISTS paths)
      if(EXISTS "${ROOT}/${path}")
        list(APPEND existing "${path}")
      endif()
    endforeach()
    if(NOT existing)
      message(FATAL_ERROR "Missing ${component} cache contents")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${archive}" --zstd --format=gnutar -- ${existing}
      WORKING_DIRECTORY "${ROOT}" COMMAND_ERROR_IS_FATAL ANY)
    file(SHA256 "${archive}" digest)
    file(WRITE "${seed}/${component}.sha256" "${digest}\n")
    file(WRITE "${seed}/${component}.key" "${key}\n")
  else()
    set(imported false)
    file(READ "${seed}/${component}.key" saved_key)
    string(STRIP "${saved_key}" saved_key)
    if(NOT "$ENV{NATIVE_${upper}_HIT}" STREQUAL "true" AND saved_key STREQUAL key)
      file(READ "${seed}/${component}.sha256" expected)
      string(STRIP "${expected}" expected)
      file(SHA256 "${archive}" actual)
      if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${component} transfer checksum mismatch")
      endif()
      execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${archive}"
        OUTPUT_VARIABLE entries COMMAND_ERROR_IS_FATAL ANY)
      string(REPLACE "\n" ";" entries "${entries}")
      foreach(entry IN LISTS entries)
        if(entry AND (NOT entry MATCHES "${allowed}" OR entry MATCHES "(^|/)\\.\\.(/|$)"))
          message(FATAL_ERROR "Unexpected cache archive entry: ${entry}")
        endif()
      endforeach()
      execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${archive}"
        WORKING_DIRECTORY "${ROOT}" COMMAND_ERROR_IS_FATAL ANY)
      set(imported true)
      message(STATUS "Imported ${component} from the native-experimental cache; no rebuild")
    else()
      message(STATUS "${component}: already cached or seed key differs")
    endif()
    file(APPEND "$ENV{GITHUB_OUTPUT}" "${component}=${imported}\n")
  endif()
endforeach()
