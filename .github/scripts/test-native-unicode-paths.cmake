cmake_minimum_required(VERSION 3.24)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(base "${root}/native/results/unicode-paths/a/b/c/d/e/f/g/ドキュメント_🧪")
file(MAKE_DIRECTORY "${base}")
file(COPY "${root}/native/install/" DESTINATION "${base}")
if(CMAKE_HOST_WIN32)
  set(executable "${base}/bin/nijitrack.exe")
else()
  set(executable "${base}/bin/nijitrack")
endif()
set(default_model "${base}/face_landmarker_v2_with_blendshapes.task")
# Exercise the missing-model fallback before installing the fixture model.
file(REMOVE "${default_model}")
execute_process(COMMAND "${executable}" -h WORKING_DIRECTORY "${base}/bin"
  OUTPUT_VARIABLE help COMMAND_ERROR_IS_FATAL ANY)
if(NOT help MATCHES "nijitrack --image")
  message(FATAL_ERROR "Unicode executable path failed")
endif()
file(COPY_FILE "${root}/native/results/ci-fixtures/face_landmarker.task" "${default_model}")
file(COPY_FILE "${root}/native/results/ci-fixtures/portrait.jpg" "${base}/入力_顔.jpg")
file(COPY_FILE "${default_model}" "${base}/モデル_顔🧪.task")
foreach(mode default explicit)
  set(model_args)
  if(mode STREQUAL "explicit")
    list(APPEND model_args --model "${base}/モデル_顔🧪.task")
  endif()
  set(json "${base}/出力_${mode}.jsonl")
  set(overlay "${base}/描画_${mode}.ppm")
  execute_process(COMMAND "${executable}" ${model_args}
    --image "${base}/入力_顔.jpg" --repeat 1 --no-osc --output "${json}" --overlay "${overlay}"
    WORKING_DIRECTORY "${base}/bin" COMMAND_ERROR_IS_FATAL ANY)
  file(STRINGS "${json}" rows ENCODING UTF-8)
  list(GET rows 0 first)
  string(JSON faces GET "${first}" face_count)
  if(faces LESS 1)
    message(FATAL_ERROR "No face detected using Unicode ${mode} model path")
  endif()
  file(SIZE "${overlay}" bytes)
  if(bytes LESS 100)
    message(FATAL_ERROR "Unicode overlay output was not written")
  endif()
endforeach()
message(STATUS "Unicode executable, default/explicit model, image, JSON and overlay paths passed")
