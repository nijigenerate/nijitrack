cmake_minimum_required(VERSION 3.24)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(native "${root}/native")
set(base "${native}/results/distribution-test/配布_🧪")
file(MAKE_DIRECTORY "${base}")
if(CMAKE_HOST_WIN32)
  set(archive "${native}/dist/nijitrack-native-windows-x86_64.zip")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${archive}"
    WORKING_DIRECTORY "${base}" COMMAND_ERROR_IS_FATAL ANY)
  set(command "${base}/bin/nijitrack.exe")
  set(models "${base}/share/nijitrack/models")
  set(tracker "bin/nijitrack.exe")
elseif(CMAKE_HOST_APPLE)
  set(archive "${native}/dist/nijitrack-native-macos-arm64.zip")
  execute_process(COMMAND ditto -x -k "${archive}" "${base}" COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND codesign --verify --deep --strict "${base}/nijitrack.app" COMMAND_ERROR_IS_FATAL ANY)
  set(command "${base}/nijitrack.app/Contents/MacOS/nijitrack")
  set(models "${base}/nijitrack.app/Contents/Resources/models")
  set(tracker "nijitrack.app/Contents/MacOS/nijitrack")
else()
  set(archive "${native}/dist/nijitrack-native-linux-x86_64.AppImage")
  set(image "${base}/nijitrack.AppImage")
  file(COPY_FILE "${archive}" "${image}")
  file(CHMOD "${image}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
  execute_process(COMMAND "${image}" --appimage-extract
    WORKING_DIRECTORY "${base}" OUTPUT_QUIET COMMAND_ERROR_IS_FATAL ANY)
  set(command "${CMAKE_COMMAND}" -E env APPIMAGE_EXTRACT_AND_RUN=1 "${image}")
  set(models "${base}/squashfs-root/usr/share/nijitrack/models")
  set(tracker "squashfs-root/usr/bin/nijitrack")
endif()
if(CMAKE_HOST_WIN32 OR CMAKE_HOST_APPLE)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${archive}"
    OUTPUT_VARIABLE entries COMMAND_ERROR_IS_FATAL ANY)
else()
  file(GLOB_RECURSE entries RELATIVE "${base}" "${base}/squashfs-root/*")
endif()
string(REPLACE "\r" "" entries "${entries}")
string(REPLACE "\n" ";" entries "${entries}")
set(count 0)
foreach(entry IN LISTS entries)
  string(REGEX REPLACE "^\\./" "" entry "${entry}")
  if(entry STREQUAL tracker)
    math(EXPR count "${count}+1")
  endif()
  if(entry MATCHES "(^|/)nijitrack-cpp(\\.exe)?$")
    message(FATAL_ERROR "Duplicate tracker in distribution: ${entry}")
  endif()
endforeach()
if(NOT count EQUAL 1)
  message(FATAL_ERROR "Expected exactly one tracker, found ${count}")
endif()
file(WRITE "${native}/results/build-environment/package-contents.txt" "${entries}\n")
file(READ "${native}/vendor/models/models.lock.json" lock)
foreach(name face_landmarker.task hand_landmarker.task)
  file(SHA256 "${models}/${name}" actual)
  string(JSON expected GET "${lock}" "${name}" sha256)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Distributed model checksum mismatch: ${name}")
  endif()
endforeach()
execute_process(COMMAND ${command} --help WORKING_DIRECTORY "${base}"
  OUTPUT_VARIABLE help COMMAND_ERROR_IS_FATAL ANY)
if(NOT help MATCHES "nijitrack --image")
  message(FATAL_ERROR "Packaged executable help failed")
endif()
# Run the final distribution from an unrelated working directory, with no
# --model and with a decoy legacy filename. Only the bundled model can work.
file(WRITE "${base}/face_landmarker_v2_with_blendshapes.task" "invalid decoy")
execute_process(COMMAND ${command} --image "${native}/results/ci-fixtures/portrait.jpg"
  --no-osc --repeat 1 --output "${base}/result.jsonl"
  WORKING_DIRECTORY "${base}" COMMAND_ERROR_IS_FATAL ANY)
file(STRINGS "${base}/result.jsonl" rows ENCODING UTF-8)
list(GET rows 0 first)
string(JSON faces GET "${first}" face_count)
if(faces LESS 1)
  message(FATAL_ERROR "Default bundled face model failed")
endif()
set(smoke "${native}/build-sdl-static/tracking-sdk-smoke${CMAKE_EXECUTABLE_SUFFIX}")
if(CMAKE_HOST_WIN32)
  set(smoke "${native}/build-sdl-static/tracking-sdk-smoke.exe")
endif()
execute_process(COMMAND "${smoke}" "${models}/face_landmarker.task" "${models}/hand_landmarker.task"
  "${native}/results/ci-fixtures/portrait.jpg" "${native}/results/ci-fixtures/right_hands.jpg"
  WORKING_DIRECTORY "${base}" COMMAND_ERROR_IS_FATAL ANY)
message(STATUS "Final distribution: one tracker, both verified models, default face inference and face/hand SDK inference passed")
